# Build our backend with WARP proxy included
FROM seiry/cloudflare-warp-proxy:latest

# Install Node.js on top of the WARP image
RUN apt-get update && apt-get install -y nodejs npm python3 python3-pip ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend code
COPY server/package*.json ./server/
COPY server ./server

# Install Node dependencies
RUN cd /app/server && npm install --ignore-scripts

# Install yt-dlp
RUN pip3 install --break-system-packages --upgrade yt-dlp

# Copy startup script
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 3001 40000

CMD ["/app/start.sh"]

